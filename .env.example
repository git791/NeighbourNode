# ============================================================
# NeighborNode — Environment Variables
#
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to version control — it contains secrets.
# The .env file is already listed in .gitignore.
# ============================================================


# ── AWS Core ──────────────────────────────────────────────────
# Your AWS region. us-east-1 is required for Bedrock Nova models.
# Run `aws configure` to set this (it will also set it in ~/.aws/config).
AWS_REGION=us-east-1


# ── DynamoDB ──────────────────────────────────────────────────
# Name of the single-table DynamoDB table.
# This is created by `sam deploy` — the exact name is in template.yaml
# under Resources > NeighborNodeTable > Properties > TableName.
# After deploy it also appears in `sam deploy` outputs.
DYNAMODB_TABLE_NAME=NeighborNodeTable


# ── Amazon Bedrock ────────────────────────────────────────────
# Model IDs used by the agent system.
# BEFORE USE: Enable model access in the AWS Console:
#   AWS Console → Amazon Bedrock → Model access
#   → Enable "Amazon Nova Lite" and "Amazon Nova Micro"
#
# Nova Lite  — used by Orchestrator, Match Agent (needs reasoning)
# Nova Micro — used by Intake Agent simple classification, Report Agent
BEDROCK_MODEL_ID=amazon.nova-lite-v1
BEDROCK_MODEL_ID_MICRO=amazon.nova-micro-v1


# ── Amazon Pinpoint SMS ───────────────────────────────────────
# Required for sending dispatch SMS to runners.
#
# Setup steps:
#   1. AWS Console → Amazon Pinpoint → Create project → name it "NeighborNode"
#   2. Under the project → SMS and voice → Enable SMS channel
#   3. Request a long code (phone number) or use the sandbox
#   4. Copy the Application ID (GUID on the project overview page)
#   5. Copy the phone number you were assigned (E.164 format: +1XXXXXXXXXX)
#
# In sandbox mode you can only send to phone numbers you've verified.
# To verify a number: Pinpoint → SMS sandbox → Destination phone numbers → Add
PINPOINT_APP_ID=your-pinpoint-application-id-here
PINPOINT_ORIGINATION_NUMBER=+1XXXXXXXXXX


# ── Guardrails ────────────────────────────────────────────────
# Path to the food-safety exclusion list (relative to project root).
# Edit config/food_safety_exclusions.json to add/remove patterns.
# This file is read at startup — no redeploy needed to update rules.
FOOD_SAFETY_EXCLUSION_LIST=config/food_safety_exclusions.json


# ── Languages ─────────────────────────────────────────────────
# Comma-separated BCP 47 language codes for the SMS intake path.
# The Intake Agent auto-detects inbound language and translates
# outbound replies to match. Add more codes as needed (e.g. en,es,pt).
SUPPORTED_LANGUAGES=en,es


# ── Coordinator ───────────────────────────────────────────────
# E.164 phone number of the human Coordinator who receives
# notifications when items are held for approval (food-safety flags,
# first-time unverified donors).
# Format: +12125551234
COORDINATOR_PHONE=+1XXXXXXXXXX


# ── AgentCore (optional — for production deployment only) ─────
# Leave blank for local development runs (local_runner.py does not use this).
# Fill in after running:
#   agentcore create --name neighbornode-orchestrator
#   agentcore add memory --name NeighborNodeMemory --strategies SEMANTIC,SUMMARIZATION
#   agentcore deploy
# Then copy the Agent ID from the output.
AGENTCORE_AGENT_ID=


# ── API Gateway (set after `sam deploy`) ──────────────────────
# The base URL output by `sam deploy`.
# Used by the frontend (set this in frontend/.env.local, not here).
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com
# API_BASE_URL=


# ── Logging ───────────────────────────────────────────────────
# Controls Python logging verbosity.
# DEBUG gives full Strands agent traces (recommended during development).
# INFO is appropriate for demo runs.
LOG_LEVEL=INFO
